root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java sources are formatted by Spotless (Palantir Java Format); these values match its output
[*.java]
indent_size = 4
max_line_length = 120

[{pom.xml,*.xml}]
indent_size = 2

[mvnw]
end_of_line = lf

[*.dart]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf
