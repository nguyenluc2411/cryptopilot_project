{
  "name": "cryptopilot-ai-service",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoPilot AI Service: the only component that calls the LLM provider. Stateless.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file=../deploy/.env dist/server.js",
    "dev": "tsx watch --env-file=../deploy/.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bottleneck": "2.19.5",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
