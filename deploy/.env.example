# Copy to deploy/.env and fill in local values. Never commit deploy/.env.
# docker compose reads this file automatically when run with -f deploy/docker-compose*.yml;
# deploy/run-backend.ps1 loads it into the backend's environment.
#
# Only the Database, Redis, Security, HTTP edge, Mail and Media storage groups are read today. The groups marked
# "reserved" belong to integrations that are not built yet; nothing reads them, and leaving them
# empty never stops the backend from starting.

# ---- Database (PostgreSQL 16 + TimescaleDB)
# DB_PORT, DB_NAME and DB_USER are read by docker compose when it starts the container.
# The backend reads DB_URL, DB_USER, DB_PASSWORD and DB_POOL_MAX, and nothing else here - so changing DB_PORT
# moves the container's port but not the one the backend dials. Set DB_URL as well when you do,
# e.g. when a PostgreSQL installed on the machine already listens on 5432.
DB_PORT=5432
DB_NAME=cryptopilot
DB_USER=cryptopilot
# Required by docker compose and by the backend; there is no fallback.
DB_PASSWORD=
# Optional in the dev profile, which falls back to the line below. Required in prod.
# DB_URL=jdbc:postgresql://localhost:5432/cryptopilot
# Optional: the backend's connection pool size (default 30). Keep it well under PostgreSQL's
# max_connections (100 in the compose file's image default).
# DB_POOL_MAX=30

# ---- Redis (latest-price cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=          # empty for local development

# ---- Security / JWT
# dev turns on the market jobs, the alert engine and the demo data; prod turns off Swagger UI.
SPRING_PROFILES_ACTIVE=dev
# The HS256 access-token signing key. At least 32 characters (256 bits), and required: the backend
# declares it with no fallback, so an environment that supplies none refuses to start rather than
# starting with a key every reader of this repository holds. The issuer is a constant in the code
# and there is no audience claim, so neither is configured here.
JWT_SECRET=

# ---- Seeded accounts
# No credential is committed anywhere, so the bootstrap administrator and the demo trader are seeded
# with whatever hash the environment supplies. Leave these empty and both accounts still exist, but
# nothing signs in to either: the fallback is a sentinel no encoder can produce. That is the expected
# state until somebody sets them, and it is also the most common reason a new clone "cannot log in".
# The administrator's hash is written by a versioned migration, so it is taken only when the
# database is created; changing it later needs a fresh database or an update of that row.
#
# The value is a BCrypt hash at strength 12, not a password - the same strength the backend encodes
# with. Any BCrypt tool produces one, and the backend never sees the password it was made from.
#
# A BCrypt hash is mostly '$'. Single-quote it here, because docker compose interpolates '$' in an
# unquoted value; deploy/run-backend.ps1 strips the quotes again before handing it to the backend.
ADMIN_PASSWORD_HASH=
DEMO_PASSWORD_HASH=

# ---- HTTP edge. Left commented, the profile defaults apply (dev: localhost, prod: none).
# An uncommented empty value overrides them, so uncomment only what you set.
# Reverse proxies whose X-Forwarded-For is believed, comma-separated IPs or CIDR ranges. Required behind Nginx in prod.
# TRUSTED_PROXIES=172.18.0.0/16
# Browser origins allowed for REST and /ws, comma-separated exact origins. Required in prod for the web client.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Requests per minute: sign-ins and other auth calls per client address, API calls per account (prod defaults).
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_API=120

# ---- Market data
# Nothing to set. Only the public Binance market data API is used, with no key; its hosts and limits
# are fixed in application.yml, and the dev profile turns the synchronisation and streams on.

# ---- Alert engine
# Nothing to set. The engine (cryptopilot.alert.*) is configured in application.yml and is on in the
# dev and prod profiles.

# ---- Payment (reserved: VNPay T-067, MoMo T-068; sandbox only)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment/result
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:5173/payment/result
MOMO_IPN_URL=

# ---- AI Service (reserved: T-072; only the AI Service will read LLM_API_KEY, the model is set in the database)
AI_SERVICE_URL=http://localhost:7070
AI_SERVICE_SHARED_SECRET=
LLM_API_KEY=

# ---- Mail (T-057): verification and password reset links
# The web app the mailed links open (<PUBLIC_BASE_URL>/verify-email?token=..., /reset-password?token=...). Required in prod.
PUBLIC_BASE_URL=http://localhost:5173
# SMTP server. Empty: no mail is sent and each link is logged as a WARN line instead (dev only; prod refuses to start).
SMTP_HOST=
# 587 with STARTTLS (Gmail, Mailtrap, most providers).
SMTP_PORT=587
# STARTTLS is required by default; set false only for a local sink without TLS (Mailpit, MailHog).
SMTP_STARTTLS_REQUIRED=true
# SMTP login; leave both empty for a server without authentication (e.g. a local Mailpit).
SMTP_USER=
# The SMTP password or app password; never commit it.
SMTP_PASSWORD=
# Sender address of every mail. Required in prod.
SMTP_FROM=no-reply@cryptopilot.local

# ---- Media storage (T-061): images and videos of community posts on Cloudinary
# The browser uploads straight to Cloudinary with a form the backend signs. All three empty: posts with media are
# refused (dev only; prod refuses to start). The secret signs uploads and reads the Admin API; never commit it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Other integrations (reserved)
# Firebase Cloud Messaging: path to the service account JSON, kept outside the repository (T-058)
FCM_SERVICE_ACCOUNT_PATH=
