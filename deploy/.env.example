# Copy to deploy/.env and fill in local values. Never commit deploy/.env.
# docker compose reads this file automatically when run with -f deploy/docker-compose*.yml

# ---- Database (PostgreSQL 16 + TimescaleDB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptopilot
DB_USER=cryptopilot
DB_PASSWORD=

# ---- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=          # empty for local development

# ---- Backend
SPRING_PROFILES_ACTIVE=dev
JWT_SIGNING_KEY=
JWT_ISSUER=cryptopilot
JWT_AUDIENCE=cryptopilot-clients
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080

# ---- Binance public market data (no API key is ever used)
BINANCE_SPOT_REST_URL=https://api.binance.com
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# ---- AI Service (only the AI Service reads LLM_API_KEY; the model is configured in the database)
AI_SERVICE_URL=http://localhost:7070
AI_SERVICE_SHARED_SECRET=
LLM_API_KEY=

# ---- VNPay (sandbox; verify URLs against the current VNPay integration documents)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# ---- MoMo (sandbox; verify URLs against the current MoMo developer documents)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:5173/payment/result
MOMO_IPN_URL=

# ---- Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cryptopilot.local

# ---- Firebase Cloud Messaging (path to the service account JSON, kept outside the repository)
FCM_SERVICE_ACCOUNT_PATH=

# ---- Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
