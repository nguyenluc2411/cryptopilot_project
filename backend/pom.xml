<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.cryptopilot</groupId>
	<artifactId>cryptopilot-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>cryptopilot</name>
	<description>CryptoPilot backend — crypto trading support system</description>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Versions of plugins and libraries outside the Spring Boot BOM are declared here only. -->
		<spotless-maven-plugin.version>2.46.1</spotless-maven-plugin.version>
		<palantir-java-format.version>2.78.0</palantir-java-format.version>
		<jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
		<!-- Spring Modulith is not part of the Spring Boot BOM; 2.1.1 is the line Spring Initializr pairs with Boot 4.1.1. -->
		<spring-modulith.version>2.1.1</spring-modulith.version>
		<!-- Kept equal to the ArchUnit version spring-modulith-core pins, so the classpath holds one ArchUnit only. -->
		<archunit.version>1.4.2</archunit.version>
		<!-- Java has no built-in UUID v7 generator; ADR-009 names this one. Not part of the Spring Boot BOM. -->
		<java-uuid-generator.version>5.2.0</java-uuid-generator.version>
		<!-- The JUnit tags the default test run leaves out; see the Surefire configuration. -->
		<surefire.excludedGroups>live</surefire.excludedGroups>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-core</artifactId>
		</dependency>

		<!-- Spring Security arrives with the first credential the system stores: it publishes the
		     BCryptPasswordEncoder of TECHNICAL_DESIGN 1.3 and the filter chain that decides which
		     endpoints are public. Everything not named in that chain is denied, so adding this
		     closes the application rather than opening it. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- TECHNICAL_DESIGN 1.3 and 5.3 name the OAuth2 Resource Server with JWT and HS256: this is
		     the half that validates a presented access token and populates the security context.
		     Nothing about it makes an endpoint reachable — the chain still denies whatever it does
		     not name — it only gives the chain an authenticated caller to reason about. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- And the half that issues one. The resource server starter brings Nimbus for verification;
		     NimbusJwtEncoder, which TECHNICAL_DESIGN 5.3 names for signing, lives in spring-security-oauth2-jose.
		     Declared explicitly rather than relied on transitively, because the class this project
		     compiles against must come from a dependency this file states. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
		</dependency>

		<!-- Spring Data JPA (Hibernate) is the persistence choice of TECHNICAL_DESIGN 1.3. It arrives
		     with the first entities; the schema stays owned by Flyway, so ddl-auto is validate. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Kept beside the JPA starter, which brings it transitively: the schema tests read the
		     catalogue with JdbcClient and must not depend on JPA for that. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<!-- The starter, not flyway-core: Spring Boot 4 moved the Flyway auto-configuration into
		     its own module, so flyway-core alone puts the library on the classpath without ever
		     running a migration. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Flyway 10 moved PostgreSQL support out of flyway-core into its own module. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.uuid</groupId>
			<artifactId>java-uuid-generator</artifactId>
			<version>${java-uuid-generator.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>${java.version}</release>
					<failOnWarning>true</failOnWarning>
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>-Xlint:all,-processing</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<!-- The signing key is a credential: the application declares it with no
						     fallback, so an environment that supplies none fails at start-up (D-20).
						     The suite therefore has to supply one, and supplies it here rather than in
						     a properties file, so that no file in the repository looks like a key and
						     no test can pass by accidentally reading a committed default. The value is
						     32 ASCII characters — 256 bits, the minimum HS256 accepts — and opens
						     nothing: it signs tokens for a database that is thrown away with the container. -->
						<JWT_SECRET>test-only-signing-key-0123456789ab</JWT_SECRET>
					</systemPropertyVariables>
					<!-- Tests tagged "live" call the real exchange. They never run in the default build:
					     a CI runner may be geo-blocked (HTTP 451) and a live market is not deterministic.
					     Run them on purpose with: ./mvnw test -Dgroups=live -Dsurefire.excludedGroups=none -->
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>

			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
						</palantirJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco-maven-plugin.version}</version>
				<configuration>
					<excludes>
						<exclude>com/cryptopilot/CryptoPilotApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.70</minimum>
										</limit>
									</limits>
								</rule>
								<rule>
									<element>PACKAGE</element>
									<includes>
										<include>com.cryptopilot.*.calculator*</include>
									</includes>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.90</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
