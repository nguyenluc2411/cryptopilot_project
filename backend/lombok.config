# Lombok is allowed in exactly two places: a getter on an entity, and the constructor that injects
# a bean's collaborators. Everything else about an entity - how it changes, what it prints, when two
# of them are equal - is written by hand, because those are the rules the design puts in the domain
# and a generated version of them is a rule nobody reviewed.
#
# Refs: T-100.

# Nothing above backend/ configures Lombok, so stop looking there.
config.stopBubbling = true

# Mark every generated member @lombok.Generated. JaCoCo skips those, so a getter nobody calls cannot
# move the coverage ratio in either direction: the gates keep measuring code that was written.
lombok.addLombokGeneratedAnnotation = true

# @ConstructorProperties on an injected constructor would invite a deserializer to build a bean.
# Nothing here is deserialized into a service, and the annotation costs a java.desktop dependency.
lombok.anyConstructor.addConstructorProperties = false

# The four that are forbidden, made unavailable rather than merely discouraged.
#
# @Setter and @Data reopen an entity to arbitrary change. An account moves between states through
# verifyEmail, lock, unlock, ban and changeRole precisely so that BR-01, BR-05 and BR-06 hold at
# every instant; a generated setter is a second way in that enforces none of them.
#
# @EqualsAndHashCode compares state. An entity is equal by identity and the base class makes both
# methods final so a persistence proxy cannot redefine them - a generated pair would either not
# compile or quietly answer a different question.
#
# @ToString prints every field. The token table stores a credential digest and the account table
# stores a password hash, and a generated toString puts both into the first log line that mentions
# the object.
#
# The build already treats warnings as errors, so ERROR is what these have to be to mean anything.
lombok.setter.flagUsage = ERROR
lombok.data.flagUsage = ERROR
lombok.equalsAndHashCode.flagUsage = ERROR
lombok.toString.flagUsage = ERROR
