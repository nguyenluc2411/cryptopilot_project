{
  "cases": [
    { "id": "BRK-01", "source": "A notional of 0 is bracket 1", "fn": "bracket",
      "input": { "brackets": "demo", "notional": "0" },
      "expect": { "bracketNo": 1, "maintenanceAmount": "0" } },
    { "id": "BRK-02", "source": "The cap is exclusive: 50,000 is bracket 2", "fn": "bracket",
      "input": { "brackets": "demo", "notional": "50000" },
      "expect": { "bracketNo": 2, "maintenanceAmount": "50" } },
    { "id": "BRK-03", "source": "Maintenance amounts filled in when missing: cum_3 = 50 + 600,000 x 0.0015", "fn": "bracket",
      "input": { "brackets": "demoNoAmounts", "notional": "700000" },
      "expect": { "bracketNo": 3, "maintenanceAmount": "950" } },
    { "id": "BRK-04", "source": "Above the largest bracket: none", "fn": "bracket",
      "input": { "brackets": "demo", "notional": "12000000" },
      "expect": { "bracketNo": null, "maintenanceAmount": null } },
    { "id": "MM-01", "source": "Bracket 1: 6,000 x 0.4 %", "fn": "maintenanceMargin",
      "input": { "brackets": "demo", "notional": "6000" },
      "expect": { "value": "24" } },
    { "id": "MM-02", "source": "Bracket 2: 100,000 x 0.5 % - 50", "fn": "maintenanceMargin",
      "input": { "brackets": "demo", "notional": "100000" },
      "expect": { "value": "450" } },
    { "id": "MM-03", "source": "Above every bracket is refused", "fn": "maintenanceMargin",
      "input": { "brackets": "demo", "notional": "20000000" },
      "expect": {}, "error": true },
    { "id": "MAXN-01", "source": "20x: the largest cap of the brackets allowing 20x", "fn": "maxNotionalAtLeverage",
      "input": { "brackets": "demo", "leverage": 20 },
      "expect": { "value": "12000000" } },
    { "id": "MAXN-02", "source": "80x", "fn": "maxNotionalAtLeverage",
      "input": { "brackets": "demo", "leverage": 80 },
      "expect": { "value": "600000" } },
    { "id": "MAXN-03", "source": "125x", "fn": "maxNotionalAtLeverage",
      "input": { "brackets": "demo", "leverage": 125 },
      "expect": { "value": "50000" } },
    { "id": "ACC-01", "source": "Unrealized profit counts for available, not for crossFreeCash", "fn": "accountMargin",
      "input": { "crossWalletBalance": "100", "crossUnrealizedPnl": "1000", "crossPositionInitialMargin": "50", "openOrderInitialMargin": "0" },
      "expect": { "availableBalance": "1050", "crossFreeCash": "50", "maxWithdrawAmount": "50" } },
    { "id": "ACC-02", "source": "Unrealized loss lowers both", "fn": "accountMargin",
      "input": { "crossWalletBalance": "100", "crossUnrealizedPnl": "-30", "crossPositionInitialMargin": "50", "openOrderInitialMargin": "0" },
      "expect": { "availableBalance": "20", "crossFreeCash": "20", "maxWithdrawAmount": "20" } },
    { "id": "ACC-03", "source": "Negative cross wallet held up by another position's profit", "fn": "accountMargin",
      "input": { "crossWalletBalance": "-500", "crossUnrealizedPnl": "2000", "crossPositionInitialMargin": "100", "openOrderInitialMargin": "0" },
      "expect": { "availableBalance": "1400", "crossFreeCash": "0", "maxWithdrawAmount": "0" } },
    { "id": "MAXO-01", "source": "Cross: available 1,050, LIMIT long 60,000, 10x", "fn": "maxOpenQuantity",
      "input": { "side": "BUY", "limitPrice": "60000", "lastPrice": "60000", "markPrice": "60000", "leverage": 10, "budget": "1050", "positionQuantity": "0", "brackets": "demo", "stepSize": "0.001" },
      "expect": { "value": "0.175" } },
    { "id": "MAXO-02", "source": "Isolated: crossFreeCash 50 for the same order", "fn": "maxOpenQuantity",
      "input": { "side": "BUY", "limitPrice": "60000", "lastPrice": "60000", "markPrice": "60000", "leverage": 10, "budget": "50", "positionQuantity": "0", "brackets": "demo", "stepSize": "0.001" },
      "expect": { "value": "0.008" } },
    { "id": "MAXO-03", "source": "A short of 0.1 is closed first for free", "fn": "maxOpenQuantity",
      "input": { "side": "BUY", "limitPrice": "60000", "lastPrice": "60000", "markPrice": "60000", "leverage": 10, "budget": "1050", "positionQuantity": "-0.1", "brackets": "demo", "stepSize": "0.001" },
      "expect": { "value": "0.275" } },
    { "id": "MAXO-04", "source": "100x caps the notional at 600,000; a long of 4 leaves 6", "fn": "maxOpenQuantity",
      "input": { "side": "BUY", "limitPrice": "60000", "lastPrice": "60000", "markPrice": "60000", "leverage": 100, "budget": "1000000000", "positionQuantity": "4", "brackets": "demo", "stepSize": "0.001" },
      "expect": { "value": "6" } },
    { "id": "REM-01", "source": "Nothing above the initial margin at the mark", "fn": "maxRemovableMargin",
      "input": { "isolatedWallet": "600", "unrealizedPnl": "0", "markNotional": "6000", "leverage": 10 },
      "expect": { "value": "0" } },
    { "id": "REM-02", "source": "IW 800 with uPnL 100 at notional 6,100: 800 + 100 - 610", "fn": "maxRemovableMargin",
      "input": { "isolatedWallet": "800", "unrealizedPnl": "100", "markNotional": "6100", "leverage": 10 },
      "expect": { "value": "290" } },
    { "id": "REM-03", "source": "Never more than the wallet", "fn": "maxRemovableMargin",
      "input": { "isolatedWallet": "100", "unrealizedPnl": "5000", "markNotional": "6000", "leverage": 10 },
      "expect": { "value": "100" } },
    { "id": "MR-01", "source": "Cross example: MM 39.1 over margin balance 4,800", "fn": "marginRatio",
      "input": { "maintenanceMargin": "39.1", "marginBalance": "4800" },
      "expect": { "value": "0.008145833333" }, "tolerance": "0.000000000001" },
    { "id": "MR-02", "source": "Margin balance gone: no ratio", "fn": "marginRatio",
      "input": { "maintenanceMargin": "21.69", "marginBalance": "0" },
      "expect": { "value": null } }
  ]
}
