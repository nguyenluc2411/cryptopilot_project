{
  "cases": [
    { "id": "COST-01", "source": "Binance, cost to open: 1 BTC LIMIT long 9,253.30, 20x, mark 9,259.84, last 9,258.99 (shown 462.67)",
      "fn": "orderCost",
      "input": { "side": "BUY", "quantity": "1", "limitPrice": "9253.30", "lastPrice": "9258.99", "markPrice": "9259.84", "leverage": 20 },
      "expect": { "value": "462.665" } },
    { "id": "COST-02", "source": "Same order short: assuming price max(last x 1.0015, mark, price), open loss 6.54 (shown 470.18)",
      "fn": "orderCost",
      "input": { "side": "SELL", "quantity": "1", "limitPrice": "9253.30", "lastPrice": "9258.99", "markPrice": "9259.84", "leverage": 20 },
      "expect": { "value": "470.18392425" } },
    { "id": "COST-03", "source": "Binance, cost to open: 0.2 BTC MARKET long, 20x, last 10,461.78, mark 10,461.83 (shown 107.90)",
      "fn": "orderCost",
      "input": { "side": "BUY", "quantity": "0.2", "limitPrice": null, "lastPrice": "10461.78", "markPrice": "10461.83", "leverage": 20 },
      "expect": { "value": "107.9032607" } },
    { "id": "COST-04", "source": "Same MARKET order short: no open loss",
      "fn": "orderCost",
      "input": { "side": "SELL", "quantity": "0.2", "limitPrice": null, "lastPrice": "10461.78", "markPrice": "10461.83", "leverage": 20 },
      "expect": { "value": "104.7747267" } },
    { "id": "IWFILL-01", "source": "Isolated long 0.1 filled at the mark, 10x",
      "fn": "isolatedFillMargin",
      "input": { "direction": "LONG", "quantity": "0.1", "fillPrice": "60000", "markPrice": "60000", "leverage": 10 },
      "expect": { "value": "600" } },
    { "id": "IWFILL-02", "source": "Isolated long filled 100 above the mark: open loss 10 moves in too",
      "fn": "isolatedFillMargin",
      "input": { "direction": "LONG", "quantity": "0.1", "fillPrice": "60100", "markPrice": "60000", "leverage": 10 },
      "expect": { "value": "611" } },
    { "id": "IWFILL-03", "source": "Isolated short filled 10 below the mark, 5x",
      "fn": "isolatedFillMargin",
      "input": { "direction": "SHORT", "quantity": "1", "fillPrice": "2990", "markPrice": "3000", "leverage": 5 },
      "expect": { "value": "608" } },
    { "id": "OOIM-01", "source": "Flat: the larger side of the open orders",
      "fn": "openOrderInitialMargin",
      "input": { "positionQuantity": "0", "orders": [ { "side": "BUY", "quantity": "0.1", "cost": "600" }, { "side": "SELL", "quantity": "0.05", "cost": "320" } ] },
      "expect": { "value": "600" } },
    { "id": "OOIM-02", "source": "Long 0.1: a SELL 0.15 opens only 0.05 short, one third of its cost",
      "fn": "openOrderInitialMargin",
      "input": { "positionQuantity": "0.1", "orders": [ { "side": "SELL", "quantity": "0.15", "cost": "950" }, { "side": "BUY", "quantity": "0.02", "cost": "120" } ] },
      "expect": { "value": "316.66666667" } },
    { "id": "OOIM-03", "source": "Short 0.2: a BUY 0.1 only reduces, costs nothing",
      "fn": "openOrderInitialMargin",
      "input": { "positionQuantity": "-0.2", "orders": [ { "side": "BUY", "quantity": "0.1", "cost": "600" }, { "side": "SELL", "quantity": "0.01", "cost": "60" } ] },
      "expect": { "value": "60" } }
  ]
}
