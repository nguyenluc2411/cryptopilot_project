# Normalize line endings in the repository; check out with the platform default
* text=auto

# Always LF (shell scripts and container files must run on Linux)
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
Dockerfile text eol=lf
*.env.example text eol=lf

# Always CRLF (Windows-only scripts)
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.ttf  binary
*.woff binary
*.woff2 binary
